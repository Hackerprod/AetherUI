@namespace ExamplesGallery.Views
@class GlassDashboardView

@code {
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            margin: 0;
            padding: 0;
            background: linear-gradient(45deg, #0f172a, #1e293b, #334155);
            background-attachment: fixed;
            font-family: 'Segoe UI', system-ui, sans-serif;
            color: white;
            display: flex;
            height: 100vh;
        }

        .sidebar {
            width: 240px;
            background: rgba(255, 255, 255, 0.05);
            border-right: 1px solid rgba(255, 255, 255, 0.1);
            padding: 32px 20px;
            display: flex;
            flex-direction: column;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            margin-bottom: 48px;
            background: linear-gradient(to right, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .nav-item {
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 8px;
            color: #94a3b8;
            text-decoration: none;
            display: flex;
            align-items: center;
        }

        .nav-item.active {
            background: rgba(255, 255, 255, 0.1);
            color: white;
        }

        .main-content {
            flex: 1;
            padding: 40px;
            overflow-y: auto;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 32px;
        }

        .grid {
            display: flex;
            flex-wrap: wrap;
            gap: 24px;
        }

        .card {
            flex: 1;
            min-width: 250px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 24px;
            padding: 24px;
        }

        .card-title {
            font-size: 14px;
            color: #94a3b8;
            margin-bottom: 12px;
        }

        .card-value {
            font-size: 32px;
            font-weight: 700;
            margin-bottom: 8px;
        }

        .card-trend {
            font-size: 12px;
            color: #4ade80;
        }

        .chart-placeholder {
            height: 200px;
            background: rgba(255, 255, 255, 0.02);
            border-radius: 16px;
            margin-top: 20px;
            display: flex;
            align-items: flex-end;
            padding: 10px;
            gap: 8px;
        }

        .bar {
            flex: 1;
            background: #60a5fa;
            border-radius: 4px;
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo">AetherUI</div>
        <div class="nav-item active">Dashboard</div>
        <div class="nav-item">Analytics</div>
        <div class="nav-item">Customers</div>
        <div class="nav-item">Settings</div>
    </div>
    <div class="main-content">
        <div class="header">
            <h1>System Overview</h1>
            <div style="background: rgba(255,255,255,0.1); padding: 8px 16px; border-radius: 10px;">
                Admin User
            </div>
        </div>
        <div class="grid">
            <div class="card">
                <div class="card-title">GPU USAGE</div>
                <div class="card-value">42%</div>
                <div class="card-trend">↑ 12% from last hour</div>
            </div>
            <div class="card">
                <div class="card-title">RENDER TIME</div>
                <div class="card-value">1.2ms</div>
                <div class="card-trend">↓ 0.3ms improvement</div>
            </div>
            <div class="card">
                <div class="card-title">MEMORY</div>
                <div class="card-value">128MB</div>
                <div class="card-trend">Stable</div>
            </div>
        </div>
        <div class="card" style="margin-top: 24px; width: auto;">
            <div class="card-title">PERFORMANCE GRAPH</div>
            <div class="chart-placeholder">
                <div class="bar" style="height: 40%;"></div>
                <div class="bar" style="height: 70%;"></div>
                <div class="bar" style="height: 55%;"></div>
                <div class="bar" style="height: 90%;"></div>
                <div class="bar" style="height: 65%;"></div>
                <div class="bar" style="height: 80%;"></div>
                <div class="bar" style="height: 45%;"></div>
            </div>
        </div>
    </div>
</body>
</html>
