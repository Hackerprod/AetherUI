@namespace ExamplesGallery.Views
@class MusicPlayerView

@code {
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #09090b;
            color: #fafafa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        .player-card {
            width: 350px;
            background: #18181b;
            border: 1px solid #27272a;
            border-radius: 24px;
            padding: 24px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        }

        .album-art {
            width: 100%;
            height: 300px;
            background: linear-gradient(135deg, #3b82f6, #8b5cf6);
            border-radius: 16px;
            margin-bottom: 24px;
            display: flex;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .album-art::after {
            content: "🎵";
            font-size: 80px;
        }

        .track-info {
            text-align: center;
            margin-bottom: 24px;
        }

        .track-title {
            font-size: 20px;
            font-weight: 700;
            margin: 0 0 4px 0;
            color: #ffffff;
        }

        .track-artist {
            font-size: 14px;
            color: #a1a1aa;
            margin: 0;
        }

        .progress-container {
            margin-bottom: 24px;
        }

        .progress-bar {
            height: 6px;
            width: 100%;
            background: #3f3f46;
            border-radius: 3px;
            position: relative;
        }

        .progress-fill {
            position: absolute;
            left: 0;
            top: 0;
            height: 100%;
            width: 65%;
            background: #3b82f6;
            border-radius: 3px;
        }

        .time-info {
            display: flex;
            justify-content: space-between;
            font-size: 12px;
            color: #71717a;
            margin-top: 8px;
        }

        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .btn {
            background: transparent;
            border: none;
            color: #ffffff;
            cursor: pointer;
            padding: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            transition: background 0.2s;
        }

        .btn-play {
            width: 56px;
            height: 56px;
            background: #ffffff;
            color: #000000;
            font-size: 20px;
        }

        .btn-secondary {
            font-size: 18px;
            color: #a1a1aa;
        }
    </style>
</head>
<body>
    <div class="player-card">
        <div class="album-art"></div>
        <div class="track-info">
            <h1 class="track-title">Aether Rhythm</h1>
            <p class="track-artist">Hackerprod & The Engine</p>
        </div>
        <div class="progress-container">
            <div class="progress-bar">
                <div class="progress-fill"></div>
            </div>
            <div class="time-info">
                <span>2:45</span>
                <span>4:12</span>
            </div>
        </div>
        <div class="controls">
            <button class="btn btn-secondary">⏮</button>
            <button class="btn btn-secondary">⏪</button>
            <button class="btn btn-play">▶</button>
            <button class="btn btn-secondary">⏩</button>
            <button class="btn btn-secondary">⏭</button>
        </div>
    </div>
</body>
</html>
