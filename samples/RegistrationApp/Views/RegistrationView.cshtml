@namespace RegistrationApp.Views
@class RegistrationView

@code {
    private string Nombre { get; set; } = string.Empty;
    private string Mensaje { get; set; } = "Completa el formulario para continuar.";
    private string ClaseBoton { get; set; } = "submit-button";

    private void MostrarEscritura(UiEvent e)
    {
        Nombre = e.Value ?? string.Empty;
        Mensaje = string.IsNullOrWhiteSpace(Nombre)
            ? "Completa el formulario para continuar."
            : $"Escribiendo: {Nombre}";
        StateHasChanged();
    }

    private void EnviarFormulario(UiEvent e)
    {
        e.PreventDefault();
        Mensaje = $"Registro enviado correctamente para {Nombre}.";
        StateHasChanged();
    }

    private void ResaltarBoton(UiEvent e)
    {
        ClaseBoton = "submit-button highlighted";
        StateHasChanged();
    }

    private void RestaurarBoton(UiEvent e)
    {
        ClaseBoton = "submit-button";
        StateHasChanged();
    }
}

<style>
  html, body {
    width: 100%;
    height: 100vh;
    margin: 0;
  }

  body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background-color: #f3f6fb;
    color: #172033;
    font-family: "Segoe UI";
  }

  .card {
    width: 440px;
    padding: 34px;
    border: 1px solid #d8deea;
    border-radius: 14px;
    background-color: white;
  }

  h1 {
    margin: 0 0 8px 0;
    font-size: 28px;
    color: #111827;
  }

  .subtitle {
    margin: 0 0 28px 0;
    color: #5f6b7a;
  }

  label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
  }

  input {
    display: block;
    width: 100%;
    height: 44px;
    margin-bottom: 18px;
    padding: 9px 12px;
    border-radius: 8px;
    font-size: 16px;
  }

  .submit-button {
    display: block;
    width: 100%;
    height: 44px;
    border-radius: 8px;
    font-size: 16px;
    font-weight: 600;
    background-color: #2563eb;
  }

  .submit-button.highlighted {
    background-color: #1e40af;
  }

  .status {
    min-height: 24px;
    margin: 20px 0 0 0;
    color: #334155;
  }

  .engine-note {
    margin: 22px 0 0 0;
    font-size: 13px;
    color: #64748b;
    text-align: center;
  }
</style>

<body>
  <main class="card">
    <h1>Registro básico</h1>
    <p class="subtitle">HTML, CSS y C# compilados por AetherUI.</p>

    <form id="miFormulario" onsubmit="@EnviarFormulario">
      <label for="nombre">Nombre</label>
      <input type="text"
             id="nombre"
             value="@Nombre"
             oninput="@MostrarEscritura"
             placeholder="Escribe tu nombre"
             maxlength="80"
             required>

      <button type="submit"
              id="btnEnviar"
              class="@ClaseBoton"
              onmouseover="@ResaltarBoton"
              onmouseout="@RestaurarBoton">
        Enviar
      </button>
    </form>

    <p id="mensajeResultado" class="status">@Mensaje</p>
    <p class="engine-note">Sin Chromium, WebView2, WPF ni WinForms.</p>
  </main>
</body>
