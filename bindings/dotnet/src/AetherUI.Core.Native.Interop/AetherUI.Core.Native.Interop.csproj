<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AetherUI.Core.Native.Interop</AssemblyName>
    <RootNamespace>AetherUI.Core.Native</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>AetherUI.Core.Native.Interop</PackageId>
    <Description>Versioned C ABI interop and native runtime assets for AetherUI.</Description>

    <AetherRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\..'))</AetherRepositoryRoot>
    <AetherNativeRuntimeIdentifier Condition="'$(AetherNativeRuntimeIdentifier)' == '' and '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</AetherNativeRuntimeIdentifier>
    <AetherNativeRuntimeIdentifier Condition="'$(AetherNativeRuntimeIdentifier)' == '' and '$(NETCoreSdkRuntimeIdentifier)' != ''">$(NETCoreSdkRuntimeIdentifier)</AetherNativeRuntimeIdentifier>
    <AetherNativeRuntimeIdentifier Condition="'$(AetherNativeRuntimeIdentifier)' == ''">win-x64</AetherNativeRuntimeIdentifier>

    <AetherNativeLibraryName Condition="'$(AetherNativeRuntimeIdentifier)' == 'win-x64' or '$(AetherNativeRuntimeIdentifier)' == 'win-arm64' or '$(AetherNativeRuntimeIdentifier)' == 'win-x86'">aether_core.dll</AetherNativeLibraryName>
    <AetherNativeInstallDirectory Condition="'$(AetherNativeLibraryName)' == 'aether_core.dll'">bin</AetherNativeInstallDirectory>
    <AetherNativeLibraryName Condition="'$(AetherNativeRuntimeIdentifier)' == 'linux-x64' or '$(AetherNativeRuntimeIdentifier)' == 'linux-arm64'">libaether_core.so</AetherNativeLibraryName>
    <AetherNativeInstallDirectory Condition="'$(AetherNativeLibraryName)' == 'libaether_core.so'">lib</AetherNativeInstallDirectory>
    <AetherNativeLibraryName Condition="'$(AetherNativeRuntimeIdentifier)' == 'osx-x64' or '$(AetherNativeRuntimeIdentifier)' == 'osx-arm64'">libaether_core.dylib</AetherNativeLibraryName>
    <AetherNativeInstallDirectory Condition="'$(AetherNativeLibraryName)' == 'libaether_core.dylib'">lib</AetherNativeInstallDirectory>
    <AetherNativeLibraryPath>$(AetherRepositoryRoot)\artifacts\native\$(AetherNativeRuntimeIdentifier)\$(AetherNativeInstallDirectory)\$(AetherNativeLibraryName)</AetherNativeLibraryPath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(AetherNativeLibraryPath)"
             Link="$(AetherNativeLibraryName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false"
             Visible="false"
             Condition="Exists('$(AetherNativeLibraryPath)')" />

    <None Include="$(AetherRepositoryRoot)\artifacts\native\win-x64\bin\aether_core.dll"
          Pack="true" PackagePath="runtimes/win-x64/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\win-x64\bin\aether_core.dll')" />
    <None Include="$(AetherRepositoryRoot)\artifacts\native\win-arm64\bin\aether_core.dll"
          Pack="true" PackagePath="runtimes/win-arm64/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\win-arm64\bin\aether_core.dll')" />
    <None Include="$(AetherRepositoryRoot)\artifacts\native\win-x86\bin\aether_core.dll"
          Pack="true" PackagePath="runtimes/win-x86/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\win-x86\bin\aether_core.dll')" />
    <None Include="$(AetherRepositoryRoot)\artifacts\native\linux-x64\lib\libaether_core.so"
          Pack="true" PackagePath="runtimes/linux-x64/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\linux-x64\lib\libaether_core.so')" />
    <None Include="$(AetherRepositoryRoot)\artifacts\native\linux-arm64\lib\libaether_core.so"
          Pack="true" PackagePath="runtimes/linux-arm64/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\linux-arm64\lib\libaether_core.so')" />
    <None Include="$(AetherRepositoryRoot)\artifacts\native\osx-x64\lib\libaether_core.dylib"
          Pack="true" PackagePath="runtimes/osx-x64/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\osx-x64\lib\libaether_core.dylib')" />
    <None Include="$(AetherRepositoryRoot)\artifacts\native\osx-arm64\lib\libaether_core.dylib"
          Pack="true" PackagePath="runtimes/osx-arm64/native/"
          Visible="false"
          Condition="Exists('$(AetherRepositoryRoot)\artifacts\native\osx-arm64\lib\libaether_core.dylib')" />
  </ItemGroup>

  <Target Name="ValidateAetherNativeRuntime"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(AetherSkipNativeLibraryValidation)' != 'true'">
    <Error Condition="'$(AetherNativeLibraryName)' == ''"
           Text="Unsupported AetherNativeRuntimeIdentifier '$(AetherNativeRuntimeIdentifier)'." />
    <Error Condition="!Exists('$(AetherNativeLibraryPath)')"
           Text="AetherUI native runtime was not found at '$(AetherNativeLibraryPath)'. Build and install native/ for RID '$(AetherNativeRuntimeIdentifier)' before building the .NET binding." />
  </Target>
</Project>
