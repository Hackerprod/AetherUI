cmake_minimum_required(VERSION 3.16)
# Explicit local invocation only. Never included by the product build or CI.
foreach(required SOURCE_DIR WORK_DIR CONFIG)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Pass -D${required}=... before -P")
    endif()
endforeach()
