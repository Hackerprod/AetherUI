endif()

# Resolve existing ancestors too, so a nonexistent child beneath a symlink cannot
# masquerade as an external directory. Never recursively remove any input path.
function(canonical_path input output)
    get_filename_component(absolute "${input}" ABSOLUTE)
    if(EXISTS "${absolute}" OR IS_SYMLINK "${absolute}")
        if(IS_SYMLINK "${absolute}" AND NOT EXISTS "${absolute}")
            message(FATAL_ERROR "Dangling symlink: ${absolute}")
        endif()
        get_filename_component(real "${absolute}" REALPATH)
    else()
        get_filename_component(parent "${absolute}" DIRECTORY)
        get_filename_component(leaf "${absolute}" NAME)
        canonical_path("${parent}" resolved_parent)
        set(real "${resolved_parent}/${leaf}")
    endif()
    set(${output} "${real}" PARENT_SCOPE)
endfunction()
canonical_path("${SOURCE_DIR}" SOURCE_DIR)
canonical_path("${WORK_DIR}" WORK_DIR)
if(NOT EXISTS "${SOURCE_DIR}/tests/package_consumer/main.c")
    message(FATAL_ERROR "SOURCE_DIR must identify the native source directory")
endif()
# The checkout boundary is the parent of native, not merely native itself.
get_filename_component(checkout "${SOURCE_DIR}" DIRECTORY)
file(RELATIVE_PATH work_relative "${checkout}" "${WORK_DIR}")
file(RELATIVE_PATH source_relative "${WORK_DIR}" "${checkout}")
if(NOT work_relative MATCHES "^\\.\\.(/|$)" OR NOT source_relative MATCHES "^\\.\\.(/|$)")
    message(FATAL_ERROR "WORK_DIR must be outside and not an ancestor of the checkout")
endif()
if(EXISTS "${WORK_DIR}")
    if(NOT IS_DIRECTORY "${WORK_DIR}")
        message(FATAL_ERROR "WORK_DIR is not a directory")
    endif()
    file(GLOB entries "${WORK_DIR}/*" "${WORK_DIR}/.[!.]*" "${WORK_DIR}/..?*")
    if(entries)
        message(FATAL_ERROR "WORK_DIR must be new or empty; refusing to delete its contents")
    endif()
endif()
