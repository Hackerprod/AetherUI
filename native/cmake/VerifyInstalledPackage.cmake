# Exercise the very same error-propagation function with a deliberately failing
# subprocess. Neither fixture touches product code.
file(WRITE "${WORK_DIR}/fail.cmake" "message(FATAL_ERROR \"intentional subprocess failure\")\n")
file(WRITE "${WORK_DIR}/failure-probe.cmake"
    "set(WORK_DIR [==[${WORK_DIR}]==])\ninclude([==[${CMAKE_CURRENT_LIST_DIR}/RunPackageCommand.cmake]==])\npackage_run(intentional-failure [==[${WORK_DIR}]==] [==[${CMAKE_COMMAND}]==] -P [==[${WORK_DIR}/fail.cmake]==])\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${WORK_DIR}/failure-probe.cmake"
    RESULT_VARIABLE probe_result OUTPUT_VARIABLE probe_out ERROR_VARIABLE probe_error)
file(WRITE "${WORK_DIR}/failure-probe.log" "result=${probe_result}\n${probe_out}\n${probe_error}")
if("${probe_result}" STREQUAL "0" OR NOT probe_error MATCHES "Stage intentional-failure failed")
    message(FATAL_ERROR "Runner failed its subprocess error-propagation self-test")
endif()

