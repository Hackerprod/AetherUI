file(COPY "${SOURCE_DIR}/tests/VerifyConsumerPaths.cmake" "${SOURCE_DIR}/tests/installed_origin.h"
    DESTINATION "${WORK_DIR}/consumer-sources")

function(check_metadata prefix)
    file(GLOB_RECURSE metadata "${prefix}/*.cmake")
    if(NOT metadata)
        message(FATAL_ERROR "No installed CMake metadata")
    endif()
    foreach(path IN LISTS metadata)
        file(READ "${path}" content)
        foreach(forbidden "${checkout}" "${producer}")
            string(FIND "${content}" "${forbidden}" found)
            if(NOT found EQUAL -1)
                message(FATAL_ERROR "Installed metadata ${path} leaks ${forbidden}")
            endif()
        endforeach()
        file(SHA256 "${path}" digest)
        file(APPEND "${WORK_DIR}/metadata-sha256.txt" "${digest}  ${path}\n")
    endforeach()
endfunction()

function(consume prefix phase)
    check_metadata("${prefix}")
    file(GLOB_RECURSE configs "${prefix}/*/AetherUIConfig.cmake")
    list(LENGTH configs count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Expected one installed AetherUIConfig.cmake under ${prefix}, found ${count}")
    endif()
    list(GET configs 0 config_file)
    get_filename_component(config_dir "${config_file}" DIRECTORY)
    foreach(language c cpp)
        if(language STREQUAL "c")
            set(name package_consumer)
            set(test_regex "^aether[.]package-consumer$")
        else()
            set(name package_consumer_cpp)
            set(test_regex "^aether[.]package-consumer-cpp$")
        endif()
        set(build "${WORK_DIR}/${phase}-${language}")
        package_run("${phase}-${language}-configure" "${WORK_DIR}" "${CMAKE_COMMAND}"
            -S "${WORK_DIR}/consumer-sources/${name}" -B "${build}" -G "${GENERATOR}"
            "-DCMAKE_BUILD_TYPE=${CONFIG}" "-DAetherUI_DIR=${config_dir}" "-DAETHER_EXPECTED_PREFIX=${prefix}"
            -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
            -DCMAKE_FIND_PACKAGE_NO_PACKAGE_REGISTRY=ON -DCMAKE_FIND_PACKAGE_NO_SYSTEM_PACKAGE_REGISTRY=ON)
        package_run("${phase}-${language}-build" "${WORK_DIR}" "${CMAKE_COMMAND}" --build "${build}" --config "${CONFIG}" --parallel 2)
        package_run("${phase}-${language}-list" "${build}" "${CTEST_EXECUTABLE}" -C "${CONFIG}" -N -R "${test_regex}")
        if(NOT PACKAGE_OUTPUT MATCHES "Total Tests: 1([^0-9]|$)")
            message(FATAL_ERROR "Expected exactly one ${language} test in ${phase}")
        endif()
        package_run("${phase}-${language}-test" "${build}" "${CTEST_EXECUTABLE}" -C "${CONFIG}" -V -R "${test_regex}")
    endforeach()
endfunction()
consume("${prefix}" original)
set(moved "${WORK_DIR}/relocated prefix with spaces")
file(RENAME "${prefix}" "${moved}")
if(EXISTS "${prefix}" OR IS_SYMLINK "${prefix}")
    message(FATAL_ERROR "Original prefix still exists after relocation")
endif()
consume("${moved}" relocated)

# LANGUAGES NONE prevents compiler failures from masquerading as package absence.
file(MAKE_DIRECTORY "${WORK_DIR}/missing-package" "${WORK_DIR}/negative-source")
file(WRITE "${WORK_DIR}/negative-source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.16)\nproject(MissingInstalledPackage LANGUAGES NONE)\nfind_package(AetherUI 0.1 CONFIG REQUIRED PATHS \"\${AetherUI_DIR}\" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK_DIR}/negative-source" -B "${WORK_DIR}/negative-build"
    -G "${GENERATOR}" "-DAetherUI_DIR=${WORK_DIR}/missing-package"
    -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF
    RESULT_VARIABLE negative_result OUTPUT_VARIABLE negative_out ERROR_VARIABLE negative_error)
file(WRITE "${WORK_DIR}/negative-configure.log" "command=${CMAKE_COMMAND} -S ${WORK_DIR}/negative-source -B ${WORK_DIR}/negative-build -G ${GENERATOR} -DAetherUI_DIR=${WORK_DIR}/missing-package -DCMAKE_FIND_USE_PACKAGE_REGISTRY=OFF -DCMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY=OFF\nresult=${negative_result}\n${negative_out}\n${negative_error}")
if("${negative_result}" STREQUAL "0" OR NOT negative_error MATCHES "Could not find a package configuration file provided by \"AetherUI\"")
    message(FATAL_ERROR "Negative configure did not fail specifically for the missing AetherUI package")
endif()
file(WRITE "${WORK_DIR}/PASS.txt" "Local installed-package gate passed: ${CONFIG}; ${CMAKE_VERSION}; ${CMAKE_HOST_SYSTEM}\nNot a full suite, CI or cross-platform certification.\n")
message(STATUS "PASS: installed C/C++ package and relocation; logs in ${WORK_DIR}")
