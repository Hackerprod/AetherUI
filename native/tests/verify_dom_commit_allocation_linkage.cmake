if(NOT EXISTS "${EXECUTABLE}" OR NOT EXISTS "${MANIFEST}")
  message(FATAL_ERROR "DOM allocation oracle executable/manifest missing")
endif()
execute_process(COMMAND "${READELF}" -d "${EXECUTABLE}" OUTPUT_VARIABLE dynamic RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR dynamic MATCHES "NEEDED[^\n]*(aether_core|libstdc\\+\\+|libgcc_s)")
  message(FATAL_ERROR "DOM allocation oracle must link product and C++ runtime objects, not their DSOs: ${dynamic}")
endif()
execute_process(COMMAND "${NM}" --defined-only "${EXECUTABLE}" OUTPUT_VARIABLE symbols RESULT_VARIABLE result)
string(REGEX MATCHALL "[ \t]aether_dom_edit_commit_v1[\r\n]" commits "${symbols}")
list(LENGTH commits count)
if(NOT result EQUAL 0 OR NOT count EQUAL 1)
  message(FATAL_ERROR "Expected exactly one product DOM commit definition")
endif()
foreach(symbol __wrap_malloc __wrap_calloc __wrap_realloc __wrap_aligned_alloc __wrap_posix_memalign _Znwm _Znam _ZnwmRKSt9nothrow_t _ZnamRKSt9nothrow_t _ZnwmSt11align_val_t _ZnamSt11align_val_t _ZnwmSt11align_val_tRKSt9nothrow_t _ZnamSt11align_val_tRKSt9nothrow_t)
  if(NOT symbols MATCHES "[ \t]${symbol}[\r\n]")
    message(FATAL_ERROR "Allocation oracle symbol not linked: ${symbol}")
  endif()
endforeach()
file(WRITE "${MANIFEST}.linkage.txt" "${dynamic}\n${symbols}")
