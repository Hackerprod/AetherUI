# Used only when the standalone consumer is invoked by the opt-in local gate.
function(package_path_inside path)
    if(NOT IS_ABSOLUTE "${path}" OR NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing/nonabsolute imported path: ${path}")
    endif()
    get_filename_component(real "${path}" REALPATH)
    file(RELATIVE_PATH relative "${AETHER_EXPECTED_PREFIX}" "${real}")
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "^\\.\\.(/|$)")
        message(FATAL_ERROR "Imported path escapes installed prefix: ${path} -> ${real}")
    endif()
    message(STATUS "Verified installed path: ${real}")
endfunction()

function(verify_package_consumer target)
    if(NOT UNIX)
        message(FATAL_ERROR "Loaded-library origin check currently requires POSIX dladdr; Windows is not validated")
    endif()
    get_filename_component(AETHER_EXPECTED_PREFIX "${AETHER_EXPECTED_PREFIX}" REALPATH)
    package_path_inside("${AetherUI_CONFIG}")
    get_target_property(imported AetherUI::Core IMPORTED)
    if(NOT imported)
        message(FATAL_ERROR "AetherUI::Core is not an imported target")
    endif()
    get_target_property(includes AetherUI::Core INTERFACE_INCLUDE_DIRECTORIES)
    if(NOT includes)
        message(FATAL_ERROR "Imported target has no public includes")
    endif()
    foreach(path IN LISTS includes)
        package_path_inside("${path}")
    endforeach()
    get_target_property(configurations AetherUI::Core IMPORTED_CONFIGURATIONS)
    set(found FALSE)
    foreach(configuration IN LISTS configurations)
        string(TOUPPER "${configuration}" configuration)
        get_target_property(location AetherUI::Core "IMPORTED_LOCATION_${configuration}")
        if(location)
            package_path_inside("${location}")
            set(found TRUE)
        endif()
    endforeach()
    if(NOT found)
        message(FATAL_ERROR "No imported library location found")
    endif()
    target_include_directories(${target} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/..")
    target_compile_definitions(${target} PRIVATE _GNU_SOURCE AETHER_VERIFY_INSTALLED_ORIGIN
        "AETHER_EXPECTED_LIBRARY=\"$<TARGET_FILE:AetherUI::Core>\"")
    target_link_libraries(${target} PRIVATE ${CMAKE_DL_LIBS})
    file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/installed-target-$<CONFIG>.txt"
        CONTENT "config=${AetherUI_CONFIG}\nlibrary=$<TARGET_FILE:AetherUI::Core>\nincludes=${includes}\n")
endfunction()
